<Window x:Class="CoffeeMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoffeeMaker"
        mc:Ignorable="d"
        Title="КофейныйМастер" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
	<Window.Resources>
		<Style TargetType="Button" x:Key="CoffeeButton">
			<Setter Property="Background" Value="#FF6F4E37"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="Padding" Value="15,5"/>
			<Setter Property="Margin" Value="5"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style TargetType="Expander" x:Key="IngredientExpander">
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="Foreground" Value="#FF6F4E37"/>
			<Setter Property="Margin" Value="0,5"/>
		</Style>

		<local:AchievementBackgroundConverter x:Key="AchievementBackgroundConverter"/>

		<Style TargetType="ProgressBar" x:Key="CoffeeProgressStyle">
			<Setter Property="Foreground" Value="#FF6F4E37"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ProgressBar">
						<Border CornerRadius="5" Background="#FFD9C7B1">
							<Grid x:Name="PART_Track">
								<Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}" RadiusX="5" RadiusY="5"/>
							</Grid>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Background="#FFE8D9C5">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Верхняя панель с вкладками и информацией пользователя -->
		<DockPanel Grid.Row="0" Margin="10">
			<TabControl DockPanel.Dock="Top" Background="Transparent" BorderThickness="0"
                        SelectionChanged="TabControl_SelectionChanged">
				<TabItem x:Name="tabCreateCoffee" Header="Создать кофе" FontSize="16" FontWeight="Bold"/>
				<TabItem x:Name="tabRecipes" Header="Рецепты" FontSize="16" FontWeight="Bold"/>
				<TabItem x:Name="tabHistory" Header="История" FontSize="16" FontWeight="Bold"/>
				<TabItem x:Name="tabAchievements" Header="Достижения" FontSize="16" FontWeight="Bold"/>
			</TabControl>

			<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
				<Border Background="#FF6F4E37" CornerRadius="5" Padding="10,5" Margin="5">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="Уровень: " Foreground="White" VerticalAlignment="Center"/>
						<TextBlock x:Name="txtUserLevel" Text="1" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
						<ProgressBar x:Name="pbUserExp" Minimum="0" Maximum="100" Value="0" Width="100" Margin="10,0" Height="15"/>
						<TextBlock Text="Баланс: " Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
						<TextBlock x:Name="txtBalance" Text="100.00 ₽" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
						<Button x:Name="btnAddMoney" Content="+" Margin="10,0,0,0" Width="30" Height="30"
                                Click="btnAddMoney_Click" Background="#FF8B6B4E" Foreground="White" FontWeight="Bold"/>
					</StackPanel>
				</Border>
			</StackPanel>
		</DockPanel>

		<!-- Основная область контента -->
		<Grid Grid.Row="1" Name="mainContentGrid">
			<!-- Экран создания кофе -->
			<Grid x:Name="createCoffeeGrid">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!-- Ингредиенты -->
				<ScrollViewer Grid.Column="0" Margin="10">
					<StackPanel>
						<Label Content="Выберите ингредиенты:" FontSize="18" FontWeight="Bold" Foreground="#FF6F4E37"/>

						<Expander Header="Основа" Style="{StaticResource IngredientExpander}" IsExpanded="True">
							<StackPanel>
								<CheckBox x:Name="chkEspresso" Content="Эспрессо (30 мл)" Margin="5,2" FontSize="14"/>
								<CheckBox x:Name="chkDoubleEspresso" Content="Двойной эспрессо (60 мл)" Margin="5,2" FontSize="14"/>
								<CheckBox x:Name="chkAmericano" Content="Американо (120 мл)" Margin="5,2" FontSize="14"/>
								<StackPanel Orientation="Horizontal">
									<Slider x:Name="sldWater" Minimum="0" Maximum="200" Value="100" Width="150" Margin="5,0"/>
									<TextBlock Text="{Binding Value, ElementName=sldWater, StringFormat={}Вода: {0} мл}" Margin="5,0"/>
								</StackPanel>
							</StackPanel>
						</Expander>

						<Expander Header="Молочные продукты" Style="{StaticResource IngredientExpander}">
							<StackPanel>
								<CheckBox x:Name="chkMilk" Content="Молоко (100 мл)" Margin="5,2" FontSize="14"/>
								<CheckBox x:Name="chkFoam" Content="Молочная пена (50 мл)" Margin="5,2" FontSize="14"/>
								<CheckBox x:Name="chkCream" Content="Сливки (50 мл)" Margin="5,2" FontSize="14"/>
								<CheckBox x:Name="chkCondensedMilk" Content="Сгущенное молоко (30 мл)" Margin="5,2" FontSize="14"/>
								<CheckBox x:Name="chkCoconutMilk" Content="Кокосовое молоко (50 мл)" Margin="5,2" FontSize="14"/>
							</StackPanel>
						</Expander>

						<Expander Header="Сиропы" Style="{StaticResource IngredientExpander}">
							<StackPanel>
								<CheckBox x:Name="chkVanilla" Content="Ванильный сироп (10 мл)" Margin="5,2" FontSize="14"/>
								<CheckBox x:Name="chkCaramel" Content="Карамельный сироп (10 мл)" Margin="5,2" FontSize="14"/>
								<CheckBox x:Name="chkChocolate" Content="Шоколадный сироп (10 мл)" Margin="5,2" FontSize="14"/>
								<CheckBox x:Name="chkHazelnut" Content="Фундучный сироп (10 мл)" Margin="5,2" FontSize="14"/>
								<CheckBox x:Name="chkMaple" Content="Кленовый сироп (10 мл)" Margin="5,2" FontSize="14"/>
								<CheckBox x:Name="chkMint" Content="Мятный сироп (10 мл)" Margin="5,2" FontSize="14"/>
							</StackPanel>
						</Expander>

						<Expander Header="Добавки" Style="{StaticResource IngredientExpander}">
							<StackPanel>
								<CheckBox x:Name="chkCinnamon" Content="Корица (2 г)" Margin="5,2" FontSize="14"/>
								<CheckBox x:Name="chkNutmeg" Content="Мускатный орех (1 г)" Margin="5,2" FontSize="14"/>
								<CheckBox x:Name="chkGinger" Content="Имбирь (3 г)" Margin="5,2" FontSize="14"/>
								<CheckBox x:Name="chkWhippedCream" Content="Взбитые сливки (30 г)" Margin="5,2" FontSize="14"/>
								<CheckBox x:Name="chkChocolateChips" Content="Шоколадная крошка (5 г)" Margin="5,2" FontSize="14"/>
							</StackPanel>
						</Expander>

						<Expander Header="Модификаторы" Style="{StaticResource IngredientExpander}">
							<StackPanel>
								<ComboBox x:Name="cmbModifiers" Margin="5" SelectedIndex="0">
									<ComboBoxItem Content="Обычный"/>
									<ComboBoxItem Content="Очень горячий"/>
									<ComboBoxItem Content="Двойная порция"/>
									<ComboBoxItem Content="С пенкой"/>
									<ComboBoxItem Content="Ледяной"/>
									<ComboBoxItem Content="С корицей"/>
								</ComboBox>
							</StackPanel>
						</Expander>
					</StackPanel>
				</ScrollViewer>

				<!-- Результат -->
				<Border Grid.Column="1" Margin="10" BorderBrush="#FF6F4E37" BorderThickness="2" CornerRadius="10" Background="White">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<Label x:Name="lblCoffeeName" Content="Ваш кофе" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="#FF6F4E37" Margin="10"/>

						<Viewbox Grid.Row="1" Stretch="Uniform" Margin="20">
							<Grid Width="200" Height="300">
								<Image x:Name="imgCoffeeCup" Source="/Images/coffee-cup.png" Width="200" Height="300"/>
								<Rectangle x:Name="rectCoffeeFill" Fill="#FF6F4E37" VerticalAlignment="Bottom" Height="0"
                                           Margin="50,0,50,50" RadiusX="10" RadiusY="10"/>
							</Grid>
						</Viewbox>

						<TextBlock x:Name="txtDescription" Grid.Row="2" TextWrapping="Wrap" Margin="15"
                                  FontSize="14" Text="Выберите ингредиенты для приготовления кофе"/>

						<ProgressBar x:Name="pbCoffeeProgress" Grid.Row="3" Minimum="0" Maximum="100" Height="20" Margin="10" Visibility="Collapsed"
                                   Style="{StaticResource CoffeeProgressStyle}"/>

						<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
							<TextBlock Text="Оценка: " FontSize="16" VerticalAlignment="Center"/>
							<TextBlock x:Name="txtRating" Text="0/10" Margin="5,0,0,0" FontSize="16"/>
							<TextBlock x:Name="txtCost" Margin="10,0,0,0" FontSize="16" Foreground="Green"/>
						</StackPanel>
					</Grid>
				</Border>
			</Grid>

			<!-- Экран рецептов -->
			<Grid x:Name="recipesGrid" Visibility="Collapsed" Margin="10">
				<StackPanel>
					<Label Content="Сохранённые рецепты:" FontSize="18" FontWeight="Bold" Foreground="#FF6F4E37"/>
					<ListView x:Name="lstRecipes" Height="300" Margin="0,10">
						<ListView.ItemTemplate>
							<DataTemplate>
								<StackPanel Margin="5">
									<TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
									<TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
								</StackPanel>
							</DataTemplate>
						</ListView.ItemTemplate>
					</ListView>
					<Button x:Name="btnDeleteRecipe" Content="Удалить рецепт"
                            Style="{StaticResource CoffeeButton}" Click="DeleteRecipe_Click"/>
				</StackPanel>
			</Grid>

			<!-- Экран истории -->
			<Grid x:Name="historyGrid" Visibility="Collapsed" Margin="10">
				<DataGrid x:Name="dgHistory" AutoGenerateColumns="False" IsReadOnly="True">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
						<DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
						<DataGridTextColumn Header="Оценка" Binding="{Binding Rating}"/>
						<DataGridTextColumn Header="Стоимость" Binding="{Binding Cost, StringFormat={}{0:0.00} ₽}"/>
					</DataGrid.Columns>
				</DataGrid>
			</Grid>

			<!-- Экран достижений -->
			<Grid x:Name="achievementsGrid" Visibility="Collapsed" Margin="10">
				<ScrollViewer>
					<ItemsControl x:Name="icAchievements">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel Orientation="Horizontal"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Width="250" Height="100" BorderBrush="#FF6F4E37" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10"
                                        Background="{Binding IsUnlocked, Converter={StaticResource AchievementBackgroundConverter}}">
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="{Binding Icon}" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
										<StackPanel VerticalAlignment="Center">
											<TextBlock Text="{Binding Title}" FontWeight="Bold"/>
											<TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
											<TextBlock Text="{Binding Progress}" FontStyle="Italic" Margin="0,5,0,0"/>
										</StackPanel>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>
		</Grid>

		<!-- Нижняя панель управления -->
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
			<Button x:Name="btnMakeCoffee" Content="Приготовить кофе!" Style="{StaticResource CoffeeButton}" Click="MakeCoffee_Click"/>
			<Button x:Name="btnSaveRecipe" Content="Сохранить рецепт" Style="{StaticResource CoffeeButton}" Click="SaveRecipe_Click"/>
			<Button x:Name="btnRandomCoffee" Content="Случайный рецепт" Style="{StaticResource CoffeeButton}" Click="RandomCoffee_Click"/>
		</StackPanel>
	</Grid>
</Window>