<Window x:Class="CoffeeMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoffeeMaker"
        mc:Ignorable="d"
        Title="КофейныйМастер" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
	<Window.Resources>
		<Style TargetType="Button" x:Key="CoffeeButton">
			<Setter Property="Background" Value="#FF6F4E37"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="Padding" Value="15,5"/>
			<Setter Property="Margin" Value="5"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style TargetType="Expander" x:Key="IngredientExpander">
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="Foreground" Value="#FF6F4E37"/>
			<Setter Property="Margin" Value="0,5"/>
		</Style>

		<local:AchievementBackgroundConverter x:Key="AchievementBackgroundConverter"/>
		<local:IngredientCheckedConverter x:Key="IngredientCheckedConverter"/>

		<Style TargetType="ProgressBar" x:Key="CoffeeProgressStyle">
			<Setter Property="Foreground" Value="#FF6F4E37"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ProgressBar">
						<Border CornerRadius="5" Background="#FFD9C7B1">
							<Grid x:Name="PART_Track">
								<Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}" RadiusX="5" RadiusY="5"/>
							</Grid>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Background="#FFE8D9C5">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Верхняя панель с вкладками и информацией пользователя -->
		<DockPanel Grid.Row="0" Margin="10">
			<TabControl DockPanel.Dock="Top" Background="Transparent" BorderThickness="0"
                        SelectionChanged="TabControl_SelectionChanged">
				<TabItem x:Name="tabCreateCoffee" Header="Создать кофе" FontSize="16" FontWeight="Bold"/>
				<TabItem x:Name="tabRecipes" Header="Рецепты" FontSize="16" FontWeight="Bold"/>
				<TabItem x:Name="tabHistory" Header="История" FontSize="16" FontWeight="Bold"/>
				<TabItem x:Name="tabAchievements" Header="Достижения" FontSize="16" FontWeight="Bold"/>
			</TabControl>

			<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
				<Border Background="#FF6F4E37" CornerRadius="5" Padding="10,5" Margin="5">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="Уровень: " Foreground="White" VerticalAlignment="Center"/>
						<TextBlock Text="{Binding UserProfile.Level}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
						<ProgressBar Minimum="0" Maximum="100" Value="{Binding UserProfile.Experience}" Width="100" Margin="10,0" Height="15"/>
						<TextBlock Text="Баланс: " Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
						<TextBlock Text="{Binding UserProfile.Balance, StringFormat={}{0:0.00} ₽}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
						<Button x:Name="btnAddMoney" Content="+" Margin="10,0,0,0" Width="30" Height="30"
                                Command="{Binding AddMoneyCommand}" Background="#FF8B6B4E" Foreground="White" FontWeight="Bold"/>
					</StackPanel>
				</Border>
			</StackPanel>
		</DockPanel>

		<!-- Основная область контента -->
		<Grid Grid.Row="1" Name="mainContentGrid">
			<!-- Экран создания кофе -->
			<Grid x:Name="createCoffeeGrid">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!-- Ингредиенты -->
				<ScrollViewer Grid.Column="0" Margin="10">
					<StackPanel>
						<Label Content="Выберите ингредиенты:" FontSize="18" FontWeight="Bold" Foreground="#FF6F4E37"/>

						<Expander Header="Основа" Style="{StaticResource IngredientExpander}" IsExpanded="True">
							<StackPanel>
								<CheckBox Content="Эспрессо (30 мл)" IsChecked="{Binding SelectedIngredients, Converter={StaticResource IngredientCheckedConverter}, ConverterParameter=Эспрессо, Mode=TwoWay}" Margin="5,2" FontSize="14"/>
								<CheckBox Content="Двойной эспрессо (60 мл)" IsChecked="{Binding SelectedIngredients, Converter={StaticResource IngredientCheckedConverter}, ConverterParameter=Двойной эспрессо, Mode=TwoWay}" Margin="5,2" FontSize="14"/>
								<CheckBox Content="Американо (120 мл)" IsChecked="{Binding SelectedIngredients, Converter={StaticResource IngredientCheckedConverter}, ConverterParameter=Американо, Mode=TwoWay}" Margin="5,2" FontSize="14"/>
								<StackPanel Orientation="Horizontal">
									<Slider x:Name="sldWater" Minimum="0" Maximum="200" Value="100" Width="150" Margin="5,0"/>
									<TextBlock Text="{Binding Value, ElementName=sldWater, StringFormat={}Вода: {0} мл}" Margin="5,0"/>
								</StackPanel>
							</StackPanel>
						</Expander>

						<Expander Header="Молочные продукты" Style="{StaticResource IngredientExpander}">
							<StackPanel>
								<CheckBox Content="Молоко (100 мл)" IsChecked="{Binding SelectedIngredients, Converter={StaticResource IngredientCheckedConverter}, ConverterParameter=Молоко, Mode=TwoWay}" Margin="5,2" FontSize="14"/>
								<CheckBox Content="Молочная пена (50 мл)" IsChecked="{Binding SelectedIngredients, Converter={StaticResource IngredientCheckedConverter}, ConverterParameter=Молочная пена, Mode=TwoWay}" Margin="5,2" FontSize="14"/>
								<CheckBox Content="Сливки (50 мл)" IsChecked="{Binding SelectedIngredients, Converter={StaticResource IngredientCheckedConverter}, ConverterParameter=Сливки, Mode=TwoWay}" Margin="5,2" FontSize="14"/>
								<CheckBox Content="Сгущенное молоко (30 мл)" IsChecked="{Binding SelectedIngredients, Converter={StaticResource IngredientCheckedConverter}, ConverterParameter=Сгущенное молоко, Mode=TwoWay}" Margin="5,2" FontSize="14"/>
								<CheckBox Content="Кокосовое молоко (50 мл)" IsChecked="{Binding SelectedIngredients, Converter={StaticResource IngredientCheckedConverter}, ConverterParameter=Кокосовое молоко, Mode=TwoWay}" Margin="5,2" FontSize="14"/>
							</StackPanel>
						</Expander>

						<Expander Header="Сиропы" Style="{StaticResource IngredientExpander}">
							<StackPanel>
								<CheckBox Content="Ванильный сироп (10 мл)" IsChecked="{Binding SelectedIngredients, Converter={StaticResource IngredientCheckedConverter}, ConverterParameter=Ванильный сироп, Mode=TwoWay}" Margin="5,2" FontSize="14"/>
								<CheckBox Content="Карамельный сироп (10 мл)" IsChecked="{Binding SelectedIngredients, Converter={StaticResource IngredientCheckedConverter}, ConverterParameter=Карамельный сироп, Mode=TwoWay}" Margin="5,2" FontSize="14"/>
								<CheckBox Content="Шоколадный сироп (10 мл)" IsChecked="{Binding SelectedIngredients, Converter={StaticResource IngredientCheckedConverter}, ConverterParameter=Шоколадный сироп, Mode=TwoWay}" Margin="5,2" FontSize="14"/>
								<CheckBox Content="Фундучный сироп (10 мл)" IsChecked="{Binding SelectedIngredients, Converter={StaticResource IngredientCheckedConverter}, ConverterParameter=Фундучный сироп, Mode=TwoWay}" Margin="5,2" FontSize="14"/>
								<CheckBox Content="Кленовый сироп (10 мл)" IsChecked="{Binding SelectedIngredients, Converter={StaticResource IngredientCheckedConverter}, ConverterParameter=Кленовый сироп, Mode=TwoWay}" Margin="5,2" FontSize="14"/>
								<CheckBox Content="Мятный сироп (10 мл)" IsChecked="{Binding SelectedIngredients, Converter={StaticResource IngredientCheckedConverter}, ConverterParameter=Мятный сироп, Mode=TwoWay}" Margin="5,2" FontSize="14"/>
							</StackPanel>
						</Expander>

						<Expander Header="Добавки" Style="{StaticResource IngredientExpander}">
							<StackPanel>
								<CheckBox Content="Корица (2 г)" IsChecked="{Binding SelectedIngredients, Converter={StaticResource IngredientCheckedConverter}, ConverterParameter=Корица, Mode=TwoWay}" Margin="5,2" FontSize="14"/>
								<CheckBox Content="Мускатный орех (1 г)" IsChecked="{Binding SelectedIngredients, Converter={StaticResource IngredientCheckedConverter}, ConverterParameter=Мускатный орех, Mode=TwoWay}" Margin="5,2" FontSize="14"/>
								<CheckBox Content="Имбирь (3 г)" IsChecked="{Binding SelectedIngredients, Converter={StaticResource IngredientCheckedConverter}, ConverterParameter=Имбирь, Mode=TwoWay}" Margin="5,2" FontSize="14"/>
								<CheckBox Content="Взбитые сливки (30 г)" IsChecked="{Binding SelectedIngredients, Converter={StaticResource IngredientCheckedConverter}, ConverterParameter=Взбитые сливки, Mode=TwoWay}" Margin="5,2" FontSize="14"/>
								<CheckBox Content="Шоколадная крошка (5 г)" IsChecked="{Binding SelectedIngredients, Converter={StaticResource IngredientCheckedConverter}, ConverterParameter=Шоколадная крошка, Mode=TwoWay}" Margin="5,2" FontSize="14"/>
							</StackPanel>
						</Expander>

						<Expander Header="Модификаторы" Style="{StaticResource IngredientExpander}">
							<StackPanel>
								<ComboBox ItemsSource="{Binding Modifiers}" SelectedItem="{Binding SelectedModifier, Mode=TwoWay}" Margin="5"/>
							</StackPanel>
						</Expander>
					</StackPanel>
				</ScrollViewer>

				<!-- Результат -->
				<Border x:Name="resultPanel" Grid.Column="1" Margin="10" BorderBrush="#FF6F4E37" BorderThickness="2" CornerRadius="10" Background="White">
					<Border.Style>
						<Style TargetType="Border">
							<Setter Property="Opacity" Value="0"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsResultVisible}" Value="True">
									<DataTrigger.EnterActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.7"/>
											</Storyboard>
										</BeginStoryboard>
									</DataTrigger.EnterActions>
									<DataTrigger.ExitActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
											</Storyboard>
										</BeginStoryboard>
									</DataTrigger.ExitActions>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Border.Style>
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<Label Content="{Binding CoffeeName}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FF6F4E37" Margin="10"/>

						<Viewbox Grid.Row="1" Stretch="Uniform" Margin="20">
							<Grid Width="200" Height="300">
								<Image x:Name="imgCoffeeCup" Source="/Images/coffee-cup.png" Width="200" Height="300"/>
								<Rectangle x:Name="rectCoffeeFill" Fill="#FF6F4E37" VerticalAlignment="Bottom" Height="0"
                                           Margin="50,0,50,50" RadiusX="10" RadiusY="10"/>
							</Grid>
						</Viewbox>

						<TextBlock Grid.Row="2" TextWrapping="Wrap" Margin="15" FontSize="14" Text="{Binding CoffeeDescription}"/>

						<ProgressBar x:Name="pbCoffeeProgress" Grid.Row="3" Minimum="0" Maximum="100" Height="20" Margin="10" Visibility="Collapsed"
                                   Style="{StaticResource CoffeeProgressStyle}"/>

						<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
							<TextBlock Text="Оценка: " FontSize="16" VerticalAlignment="Center"/>
							<TextBlock Text="{Binding CoffeeRating}" Margin="5,0,0,0" FontSize="16"/>
							<TextBlock Text="{Binding CoffeeCost}" Margin="10,0,0,0" FontSize="16" Foreground="Green"/>
						</StackPanel>
					</Grid>
				</Border>
			</Grid>

			<!-- Экран рецептов -->
			<Grid x:Name="recipesGrid" Visibility="Collapsed" Margin="10">
				<StackPanel>
					<Label Content="Сохранённые рецепты:" FontSize="18" FontWeight="Bold" Foreground="#FF6F4E37"/>
					<ListView x:Name="lstRecipes" Height="300" Margin="0,10" ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}">
						<ListView.ItemTemplate>
							<DataTemplate>
								<StackPanel Margin="5">
									<TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
									<TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
								</StackPanel>
							</DataTemplate>
						</ListView.ItemTemplate>
					</ListView>
					<Button x:Name="btnDeleteRecipe" Content="Удалить рецепт" Style="{StaticResource CoffeeButton}" Command="{Binding DeleteRecipeCommand}"/>
				</StackPanel>
			</Grid>

			<!-- Экран истории -->
			<Grid x:Name="historyGrid" Visibility="Collapsed" Margin="10">
				<DataGrid x:Name="dgHistory" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding CoffeeHistory}">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
						<DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
						<DataGridTextColumn Header="Оценка" Binding="{Binding Rating}"/>
						<DataGridTextColumn Header="Стоимость" Binding="{Binding Cost, StringFormat={}{0:0.00} ₽}"/>
					</DataGrid.Columns>
				</DataGrid>
			</Grid>

			<!-- Экран достижений -->
			<Grid x:Name="achievementsGrid" Visibility="Collapsed" Margin="10">
				<ScrollViewer>
					<ItemsControl x:Name="icAchievements" ItemsSource="{Binding Achievements}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel Orientation="Horizontal"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Width="250" Height="100" BorderBrush="#FF6F4E37" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10"
                                        Background="{Binding IsUnlocked, Converter={StaticResource AchievementBackgroundConverter}}">
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="{Binding Icon}" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
										<StackPanel VerticalAlignment="Center">
											<TextBlock Text="{Binding Title}" FontWeight="Bold"/>
											<TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
											<TextBlock Text="{Binding Progress}" FontStyle="Italic" Margin="0,5,0,0"/>
										</StackPanel>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>
		</Grid>

		<!-- Нижняя панель управления -->
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
			<Button x:Name="btnMakeCoffee" Content="Приготовить кофе!" Style="{StaticResource CoffeeButton}" Command="{Binding MakeCoffeeCommand}"/>
			<Button x:Name="btnSaveRecipe" Content="Сохранить рецепт" Style="{StaticResource CoffeeButton}" Command="{Binding SaveRecipeCommand}"/>
			<Button x:Name="btnRandomCoffee" Content="Случайный рецепт" Style="{StaticResource CoffeeButton}" Command="{Binding RandomCoffeeCommand}"/>
			<Button Content="Сохранить историю" Style="{StaticResource CoffeeButton}" Command="{Binding SaveHistoryToJsonCommand}"/>
			<Button Content="Загрузить историю" Style="{StaticResource CoffeeButton}" Command="{Binding LoadHistoryFromJsonCommand}"/>
			<Button Content="Сохранить рецепты" Style="{StaticResource CoffeeButton}" Command="{Binding SaveRecipesToJsonCommand}"/>
			<Button Content="Загрузить рецепты" Style="{StaticResource CoffeeButton}" Command="{Binding LoadRecipesFromJsonCommand}"/>
			<Button Content="Профиль" Width="100" Margin="10,0,0,0" Click="Profile_Click"/>
		</StackPanel>
	</Grid>
</Window>