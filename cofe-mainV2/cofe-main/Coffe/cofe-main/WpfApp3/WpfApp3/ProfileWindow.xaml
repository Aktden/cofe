<Window x:Class="CoffeeMaker.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профиль пользователя" Height="400" Width="400">
    <Grid Background="#FFE8D9C5">
        <StackPanel Margin="20" VerticalAlignment="Center">
            <TextBlock Text="Профиль пользователя" FontSize="22" FontWeight="Bold" Foreground="#FF6F4E37" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            <TextBlock Text="Уровень:" FontWeight="Bold"/>
            <TextBlock Text="{Binding Level}" Margin="0,0,0,10"/>
            <TextBlock Text="Опыт:" FontWeight="Bold"/>
            <TextBlock Text="{Binding Experience}" Margin="0,0,0,10"/>
            <TextBlock Text="Баланс:" FontWeight="Bold"/>
            <TextBlock Text="{Binding Balance, StringFormat={}{0:0.00} ₽}" Margin="0,0,0,10"/>
            <TextBlock Text="Приготовлено кофе:" FontWeight="Bold"/>
            <TextBlock Text="{Binding CoffeesMade}" Margin="0,0,0,10"/>
            <TextBlock Text="Уникальных рецептов:" FontWeight="Bold"/>
            <TextBlock Text="{Binding UniqueCoffeesMade}" Margin="0,0,0,10"/>
            <TextBlock Text="Достижений разблокировано:" FontWeight="Bold"/>
            <TextBlock Text="{Binding AchievementsUnlocked}" Margin="0,0,0,10"/>
            <Button Content="Закрыть" Width="100" Margin="0,20,0,0" Click="Close_Click" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window> 